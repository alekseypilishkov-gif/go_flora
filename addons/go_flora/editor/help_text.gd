static func tip(key: String) -> String:
	return TIPS.get(key, "")

static func apply(control: Control, key: String) -> void:
	control.tooltip_text = tip(key)
	control.set_meta("go_flora_help_key", key)
	if control is SpinBox:
		control.get_line_edit().tooltip_text = tip(key)
		control.get_line_edit().set_meta("go_flora_help_key", key)

static func legend() -> String:
	var text := "GO_FLORA — палитра, кисть и Alpha Plant\n\nИсточник = растение; VegetationSet = группа. Выбор растения не равен инструменту Single.\nCtrl+Alt+G показывает GO_FLORA. Сохранённый левый dock можно один раз перетащить к Inspector.\n\n"
	for key in TIPS:
		text += key + "\n" + TIPS[key] + "\n\n"
	return text
